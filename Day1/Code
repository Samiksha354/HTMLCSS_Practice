///////////////////////////////css//////////////////////////////////////////
section{
    min-height: 100vh;

    display: flex;

    justify-content: center;
    align-items: center;

    background-color: #f4f4f4;
}

.Profile-Card{
  
    width:350px;
    padding:25px;


    border:2px solid black;
    border-radius: 50px;

    background-color: aliceblue;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
}
.image{
    display: flex;
     height:120px;
   justify-content: center;
   align-items: center;
}
img{
    
    width: 100px;
    height:100px;
    border:1px solid black;
    border-radius:50%;
}

.information {
    text-align: center;
}

ul {
    list-style-position: inside;
    padding: 0;
}

.buttons{
    display: flex;
    justify-content: center;

    gap: 15px;

    margin-top: 20px;
}

.bb{
     padding: 10px 18px;
    border: 1px solid #451e02 ;
    border-radius: 20px;
    background-color:chocolate;
    color: white;

    cursor: pointer;
}

.bb:hover{
    background-color: blueviolet;
}
