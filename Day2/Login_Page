///////////////////////////////////////////////////login page/////////////////////////////////////////////////////////////


####################################################   HTML   ############################################################

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="style.css">
    <title>Login Page</title>
</head>
<body>
    <section>
        
        <main>
            <div class="welcome">
                    <h3>Welcome Back</h3>
                    <h4>Login to your account</h4>
            </div>
            <form>
            <div class="info">
                <label>Email Address</label>
                <input 
                    type="email"
                    id="email"
                    name="email"
                    placeholder="Enter your email"
                >
                
                <label>Password</label>
                <input type="password"
                        id="password"
                       name="password"
                       placeholder="Enter password"
                    >
            </div>
            <div class="info2">
                <label>
                <intput type="checkbox">
                    Remember me
                </label>

                <a href="#">Forgot Password?</a>
            </div>
            <button type="submit">LOGIN</button>

             </form>
             
            <div class="info3">
                <p>Don't have an account?</p>
                <a href="#">Sign Up</a>
            </div>
           
        </main>
        
    </section>
</body>
</html>




###################################################### CSS ############################################################



* {
    box-sizing: border-box;
}




section{
    font-size: medium;
    font-style: italic;
     min-height: 100vh;

    display: flex;
    justify-content: center;
    align-items: center;

    background-color: #f4f4f4;
}

main{
    
    width:350px;
    padding: 30px; 
   
    background-color: cadetblue;

    border:2px solid rgb(17, 17, 72);
   border-radius: 20px;

   box-shadow: 0px 14px 14px 0px black;
   
}

.welcome{
    
    text-align: center;
     margin-bottom: 25px;
    
}
.info{
    display:flex;
    flex-direction: column;
    gap: 8px;
}

.info input {
    width: 100%;
    padding: 10px;

    border: 1px solid gray;
    border-radius: 8px;

    margin-bottom: 12px;
}  

.info input:focus {
    outline: 2px solid blue;
}

.info2{
    margin-top:20px;
   
    display:flex;
    justify-content: space-between;
    align-items: center;
   
}

.info2 label {
    display: flex;
    align-items: center;
    gap: 5px;
}

.info2 a,
.info3 a {
    text-decoration: none;
}

button{
    width:100%;

    padding:10px;

     
    background-color: rgb(14, 14, 61);
    color:white;

    border:2px solid silver;
    border-radius: 8px;

    margin-top:25px;
    

    cursor: pointer;
    
}

button:hover{
     background-color: brown;
}

.info3{
    display:flex;
    justify-content: center;
    align-items: center;

     gap: 5px;

    margin-top: 20px;
}



